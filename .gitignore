# Local agent state and credentials; the gstack pre-gate's policy is shared
.gstack/*
!.gstack/pregate.json
.DS_Store
.env
.env.*
!.env.example

# Large or private runtime evidence; keep sanitized manifests in cycle records
artifacts/
# The working folder playwright-cli leaves where the Reader DOM check is started
.playwright-cli/
node_modules/
extension/dist/
extension/coverage/
extension/.fallow/

# Share this project's agent entry points despite user-global ignore rules
!/AGENTS.md
!/CLAUDE.md

# Share only the project compaction hook; keep other local Codex state private.
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.codex/restore-product-context.mjs
!/.codex/restore-product-context.test.mjs

# Share only the Claude Code compaction hook registration; keep other local Claude state private.
!/.claude/
/.claude/*
!/.claude/settings.json
