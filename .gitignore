# Local agent state and credentials
.gstack/
.DS_Store
.env
.env.*
!.env.example

# Large or private runtime evidence; keep sanitized manifests in cycle records
artifacts/
node_modules/
experiments/*/dist/
experiments/*/build/
extension/dist/

# Share this project's agent entry points despite user-global ignore rules
!/AGENTS.md
!/CLAUDE.md

# Share project hook files without exposing local Codex state.
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.codex/restore-product-context.mjs
!/.codex/restore-product-context.test.mjs
!/.codex/README.md
