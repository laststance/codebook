{
  "name": "codebook-cycle-0001",
  "displayName": "codebook Cycle 0001 Experiment",
  "publisher": "laststance",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=24"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p fixture/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p fixture/tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "experiment": "pnpm build && node dist/runner.js"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/vscode": "1.120.0",
    "@types/ws": "8.18.1",
    "@vscode/debugprotocol": "1.68.0",
    "devtools-protocol": "0.0.1698617",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
