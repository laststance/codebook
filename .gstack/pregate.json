  "strays": {
    "allow": [
      ".gstack"
    ]
  },
  "warn": [
    "literals"
  ],
  "allowlist": [
    {
      "finding": "auth.bearer",
      "paths": [
        "extension/src/tests/chromeExtension*.test.ts"
      ],
      "pattern": "abcdefghijklmnop1234567890",
      "reason": "the dummy bearer token the chrome-extension masking tests feed in; never a credential"
    },
    {
      "finding": "env.kv",
      "paths": [
        "extension/src/tests/chromeExtensionObservation.test.ts"
      ],
      "pattern": "\\[masked\\]",
      "reason": "the mask placeholder an observed-value masking test expects; no secret value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "extension/src/tests/chromeExtensionService.test.ts"
      ],
      "pattern": "extension-run",
      "reason": "a codebook_start idempotency key named key in a test; no secret value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "extension/src/tests/configuredService.test.ts",
        "extension/src/tests/viteRunResource.test.ts",
        "extension/src/tests/utils/pausedViteRun.ts"
      ],
      "pattern": "vite-[a-z-]+",
      "reason": "codebook_start idempotency keys named key in the vite-dev tests and their paused-run helper; no secret value"
    },
    {
      "finding": "env.kv",
      "paths": [
        "extension/src/tests/viteDevScript.test.ts"
      ],
      "pattern": "plainsecret1",
      "reason": "the dummy assignment value a dev-script refusal test expects to see masked; never a credential"
    },
    {
      "finding": "creds.basic_auth_url",
      "paths": [
        "extension/src/tests/viteLauncher.test.ts",
        "extension/src/tests/viteWorkspace.test.ts",
        ".gstack-redact-allowlist"
      ],
      "pattern": "https[:]//u(?:ser)?:(?:plainsecretpw|pw|\\[masked\\])@[a-z.]+",
      "reason": "dummy basic-auth URLs the Vite settings and masking tests feed in or expect masked, and the pre-push guard's allowlist that names them; never a credential"
    }
  ]
}
