{
  "name": "codebook",
  "displayName": "codebook",
  "description": "Connect an external agent to source-grounded codebase studies.",
  "publisher": "laststance",
  "version": "0.2.60",
  "private": true,
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=24"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Agent execution requires a trusted local workspace.",
      "restrictedConfigurations": [
        "codebook.wikiOutputDirectory"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configurationDefaults": {
      "debug.focusEditorOnBreak": false
    },
    "debuggers": [
      {
        "type": "codebook-replay",
        "label": "Codebook Recorded Learning",
        "configurationAttributes": {
          "launch": {
            "required": [
              "codebookReplayOwner"
            ],
            "properties": {
              "codebookReplayOwner": {
                "type": "string",
                "description": "Owned by the Codebook replay UI. Open saved learning to start this read-only session."
              }
            }
          }
        }
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/codebook/SKILL.md"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "laststance.codebook.currentWorkspace",
        "label": "Codebook current workspace"
      }
    ],
    "commands": [
      {
        "command": "codebook.startAgentServer",
        "title": "Codebook: Start Agent Server"
      },
      {
        "command": "codebook.stopAgentServer",
        "title": "Codebook: Stop Agent Server"
      },
      {
        "command": "codebook.copyAgentConnection",
        "title": "Codebook: Copy Agent Connection"
      },
      {
        "command": "codebook.setupAiChat",
        "title": "Codebook: Set Up AI Chat"
      },
      {
        "command": "codebook.removeManagedCursorSkill",
        "title": "Codebook: Remove Managed Cursor Skill"
      },
      {
        "command": "codebook.restoreManagedCursorSkill",
        "title": "Codebook: Restore Managed Cursor Skill"
      },
      {
        "command": "codebook.openStudyWorkspace",
        "title": "Codebook: Open Study Workspace"
      },
      {
        "command": "codebook.closeStudyWorkspace",
        "title": "Codebook: Close Study Workspace"
      },
      {
        "command": "codebook.markUnderstanding",
        "title": "Codebook: Toggle Understanding for Selected Source"
      },
      {
        "command": "codebook.study.run",
        "title": "Codebook: Run Selected Study Scenario"
      },
      {
        "command": "codebook.study.click",
        "title": "Codebook: Perform Next Scenario Action Once"
      },
      {
        "command": "codebook.study.continue",
        "title": "Codebook: Continue Inspected Pause"
      },
      {
        "command": "codebook.study.stop",
        "title": "Codebook: Stop Study Run"
      },
      {
        "command": "codebook.study.return-current",
        "title": "Codebook: Return to Current Pause"
      },
      {
        "command": "codebook.study.source",
        "title": "Codebook: Focus Captured Source"
      },
      {
        "command": "codebook.study.current-file",
        "title": "Codebook: Open Current Source File"
      },
      {
        "command": "codebook.study.focus-app",
        "title": "Codebook: Focus Application"
      },
      {
        "command": "codebook.study.focus-context",
        "title": "Codebook: Focus Explanation"
      },
      {
        "command": "codebook.study.read-app",
        "title": "Codebook: Read Application"
      },
      {
        "command": "codebook.study.read-source",
        "title": "Codebook: Read Captured Source"
      },
      {
        "command": "codebook.study.read-context",
        "title": "Codebook: Read Explanation"
      },
      {
        "command": "codebook.study.outline",
        "title": "Codebook: Show Learning Outline"
      },
      {
        "command": "codebook.study.arrange",
        "title": "Codebook: Arrange Study Workspace"
      },
      {
        "command": "codebook.study.retry",
        "title": "Codebook: Retry Study Storage"
      },
      {
        "command": "codebook.openRepositoryWiki",
        "title": "Codebook: Open Repository Wiki"
      },
      {
        "command": "codebook.openDeepWiki",
        "title": "Codebook: Open LLM Wiki in Browser"
      },
      {
        "command": "codebook.generateDeepWiki",
        "title": "Codebook: Generate LLM Wiki",
        "shortTitle": "Try Again",
        "icon": "$(debug-restart)"
      },
      {
        "command": "codebook.updateDeepWiki",
        "title": "Codebook: Update LLM Wiki",
        "shortTitle": "Update LLM Wiki",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codebook.cancelWikiRun",
        "title": "Codebook: Stop LLM Wiki Run"
      },
      {
        "command": "codebook.showWikiOutput",
        "title": "Codebook: Show LLM Wiki Output",
        "shortTitle": "Show Output",
        "icon": "$(output)"
      },
      {
        "command": "codebook.closeRepositoryWiki",
        "title": "Codebook: Close Repository Wiki"
      },
      {
        "command": "codebook.study.return-wiki",
        "title": "Codebook: Return to Wiki"
      },
      {
        "command": "codebook.saveLearningReplay",
        "title": "Codebook: Save Learning Replay"
      },
      {
        "command": "codebook.showLearningSummary",
        "title": "Codebook: Show Learning Summary",
        "icon": "$(book)"
      },
      {
        "command": "codebook.moveLearningSummary",
        "title": "Codebook: Move Learning Summary…",
        "icon": "$(move)"
      },
      {
        "command": "codebook.refreshLlmWiki",
        "title": "Codebook: Refresh LLM Wiki",
        "shortTitle": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "codebook.showLlmWikiAttention",
        "title": "Codebook: Show LLM Wiki Details"
      },
      {
        "command": "codebook.copyWikiRecoveryRequest",
        "title": "Codebook: Copy LLM Wiki Recovery Request",
        "shortTitle": "Copy Recovery Request",
        "icon": "$(copy)"
      },
      {
        "command": "codebook.revealWikiFolder",
        "title": "Codebook: Reveal LLM Wiki Folder",
        "shortTitle": "Reveal Wiki Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codebook.llmWiki.stopWatching",
        "title": "Stop Watching",
        "icon": "$(eye-closed)"
      },
      {
        "command": "codebook.llmWiki.cancelRun",
        "title": "Cancel",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codebook.llmWiki.openChat",
        "title": "Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codebook.llmWiki.changeLocation",
        "title": "Change Location",
        "icon": "$(edit)"
      },
      {
        "command": "codebook.llmWiki.openFolder",
        "title": "Open Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codebook.llmWiki.manageTrust",
        "title": "Manage Workspace Trust",
        "icon": "$(shield)"
      }
    ],
    "configuration": {
      "title": "codebook",
      "properties": {
        "codebook.wikiOutputDirectory": {
          "type": "string",
          "default": ".codebook/wiki",
          "scope": "resource",
          "description": "Folder for the editor agent's generated DeepWiki site. Relative paths resolve inside the opened project; absolute paths select another local folder."
        },
        "codebook.nodeExecutable": {
          "type": "string",
          "default": "node",
          "scope": "machine",
          "description": "External Node.js executable (24 or later); never the editor's Electron binary."
        },
        "codebook.chromeExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Chrome executable for the configured repository browser. When empty, Codebook uses /Applications/Google Chrome.app/Contents/MacOS/Google Chrome on macOS and the first google-chrome, google-chrome-stable, chromium or chromium-browser on PATH on Linux (including WSL)."
        },
        "codebook.savedStudyLimit": {
          "type": "integer",
          "default": 64,
          "minimum": 1,
          "maximum": 256,
          "scope": "resource",
          "description": "Maximum new saved studies and recordings per workspace. When the library is full, increase this or delete a saved study from Saved studies in the Study workspace. Lowering it keeps existing history readable; no recordings are automatically deleted. Each recording consumes disk space. Changes apply to the next admission without restarting."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codebook",
          "title": "codebook",
          "icon": "src/assets/book.svg"
        },
        {
          "id": "codebookLearning",
          "title": "Learning summary",
          "icon": "src/assets/learning.svg"
        }
      ],
      "panel": [
        {
          "id": "codebookMoments",
          "title": "codebook",
          "icon": "src/assets/book.svg"
        }
      ]
    },
    "views": {
      "codebook": [
        {
          "id": "codebook.repositoryWiki",
          "name": "Repository Wiki"
        },
        {
          "id": "codebook.llmWiki",
          "name": "LLM Wiki"
        },
        {
          "id": "codebook.learningOutline",
          "name": "Learning outline"
        }
      ],
      "codebookMoments": [
        {
          "id": "codebook.observedMoments",
          "name": "Observed moments",
          "type": "webview"
        }
      ],
      "codebookLearning": [
        {
          "id": "codebook.learningSummary",
          "name": "Learning summary",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codebook.llmWiki",
        "when": "codebook.llmWiki.state == none && codebook.host == vscode",
        "contents": "Explore this project through source-linked chapters, diagrams and questions, written by your editor's AI.\n[Generate LLM Wiki](command:codebook.generateDeepWiki)\nIt runs in a new Copilot Chat session and uses your chat plan. The chat asks you to approve its commands and may ask you to Continue; keep the Chat view open.\nThe Wiki is written to .codebook/wiki unless the setting codebook.wikiOutputDirectory names another folder. [Change location](command:workbench.action.openSettings?%5B%22%40id%3Acodebook.wikiOutputDirectory%22%5D)"
      },
      {
        "view": "codebook.llmWiki",
        "when": "codebook.llmWiki.state == none && codebook.host == cursor",
        "contents": "Explore this project through source-linked chapters, diagrams and questions, written by your editor's AI.\n[Generate LLM Wiki](command:codebook.generateDeepWiki)\nIt runs through Cursor's agent CLI (cursor-agent), uses your Cursor plan and can take several minutes. You can keep working.\nThe Wiki is written to .codebook/wiki unless the setting codebook.wikiOutputDirectory names another folder. [Change location](command:workbench.action.openSettings?%5B%22%40id%3Acodebook.wikiOutputDirectory%22%5D)"
      },
      {
        "view": "codebook.learningOutline",
        "contents": "Connect the application screen with its actual code.\n[Open Study workspace](command:codebook.openStudyWorkspace)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codebook.showLearningSummary",
          "when": "view == codebook.learningOutline",
          "group": "navigation"
        },
        {
          "command": "codebook.moveLearningSummary",
          "when": "view == codebook.learningSummary && codebook.learningSummaryMovable",
          "group": "navigation"
        },
        {
          "command": "codebook.refreshLlmWiki",
          "when": "view == codebook.llmWiki",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codebook.moveLearningSummary",
          "when": "codebook.learningSummaryMovable"
        },
        {
          "command": "codebook.refreshLlmWiki",
          "when": "codebook.llmWiki.state"
        },
        {
          "command": "codebook.copyWikiRecoveryRequest",
          "when": "codebook.llmWiki.state"
        },
        {
          "command": "codebook.revealWikiFolder",
          "when": "codebook.llmWiki.state"
        },
        {
          "command": "codebook.showLlmWikiAttention",
          "when": "false"
        },
        {
          "command": "codebook.llmWiki.stopWatching",
          "when": "false"
        },
        {
          "command": "codebook.llmWiki.cancelRun",
          "when": "false"
        },
        {
          "command": "codebook.llmWiki.openChat",
          "when": "false"
        },
        {
          "command": "codebook.llmWiki.changeLocation",
          "when": "false"
        },
        {
          "command": "codebook.llmWiki.openFolder",
          "when": "false"
        },
        {
          "command": "codebook.llmWiki.manageTrust",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "codebook.updateDeepWiki",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[update\\]/",
          "group": "inline@0"
        },
        {
          "command": "codebook.updateDeepWiki",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[update\\]/",
          "group": "llmWiki@0"
        },
        {
          "command": "codebook.llmWiki.stopWatching",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[stop-watching\\]/",
          "group": "inline@1"
        },
        {
          "command": "codebook.llmWiki.stopWatching",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[stop-watching\\]/",
          "group": "llmWiki@1"
        },
        {
          "command": "codebook.llmWiki.cancelRun",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[cancel-run\\]/",
          "group": "inline@2"
        },
        {
          "command": "codebook.llmWiki.cancelRun",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[cancel-run\\]/",
          "group": "llmWiki@2"
        },
        {
          "command": "codebook.llmWiki.openChat",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[open-chat\\]/",
          "group": "inline@3"
        },
        {
          "command": "codebook.llmWiki.openChat",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[open-chat\\]/",
          "group": "llmWiki@3"
        },
        {
          "command": "codebook.showWikiOutput",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[show-output\\]/",
          "group": "inline@4"
        },
        {
          "command": "codebook.showWikiOutput",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[show-output\\]/",
          "group": "llmWiki@4"
        },
        {
          "command": "codebook.generateDeepWiki",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[try-again\\]/",
          "group": "inline@5"
        },
        {
          "command": "codebook.generateDeepWiki",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[try-again\\]/",
          "group": "llmWiki@5"
        },
        {
          "command": "codebook.llmWiki.changeLocation",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[change-location\\]/",
          "group": "inline@6"
        },
        {
          "command": "codebook.llmWiki.changeLocation",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[change-location\\]/",
          "group": "llmWiki@6"
        },
        {
          "command": "codebook.copyWikiRecoveryRequest",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[copy-recovery\\]/",
          "group": "inline@7"
        },
        {
          "command": "codebook.copyWikiRecoveryRequest",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[copy-recovery\\]/",
          "group": "llmWiki@7"
        },
        {
          "command": "codebook.revealWikiFolder",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[reveal-folder\\]/",
          "group": "inline@8"
        },
        {
          "command": "codebook.revealWikiFolder",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[reveal-folder\\]/",
          "group": "llmWiki@8"
        },
        {
          "command": "codebook.refreshLlmWiki",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[refresh\\]/",
          "group": "inline@9"
        },
        {
          "command": "codebook.refreshLlmWiki",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[refresh\\]/",
          "group": "llmWiki@9"
        },
        {
          "command": "codebook.llmWiki.openFolder",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[open-folder\\]/",
          "group": "inline@10"
        },
        {
          "command": "codebook.llmWiki.openFolder",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[open-folder\\]/",
          "group": "llmWiki@10"
        },
        {
          "command": "codebook.llmWiki.manageTrust",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[manage-trust\\]/",
          "group": "inline@11"
        },
        {
          "command": "codebook.llmWiki.manageTrust",
          "when": "view == codebook.llmWiki && viewItem =~ /\\[manage-trust\\]/",
          "group": "llmWiki@11"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-metadata.mjs",
    "build:fast": "node scripts/build-fast.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "package": "node scripts/package.mjs",
    "package:check": "node scripts/check-package.mjs",
    "test:shard": "node scripts/test-shard.mjs",
    "test:package": "node --test --test-concurrency=4 scripts/tests/*.test.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test:coverage": "pnpm build && c8 node --test dist/tests/*.test.js",
    "lint": "eslint . --concurrency=auto --max-warnings=0",
    "lint:fix": "eslint . --fix --concurrency=auto --max-warnings=0",
    "format": "cd .. && prettier --write .",
    "format:check": "cd .. && prettier --check .",
    "health": "node scripts/checkHealth.mjs",
    "gate": "node scripts/gate.mjs",
    "health:static": "fallow health --complexity --max-crap inf --baseline-mode identity --fail-on-issues --baseline fallow-health-baseline.json",
    "dupes": "fallow dupes --fail-on-issues --baseline fallow-dupes-baseline.json",
    "dead-code": "fallow dead-code --fail-on-issues --baseline fallow-dead-code-baseline.json",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm health:static && pnpm test && pnpm test:package && pnpm dupes && pnpm dead-code && pnpm health"
  },
  "lint-staged": {
    "!(*.ts)": "prettier --ignore-unknown --write --ignore-path ../.gitignore --ignore-path ../.prettierignore",
    "*.ts": [
      "prettier --ignore-unknown --write --ignore-path ../.gitignore --ignore-path ../.prettierignore",
      "eslint --cache --no-warn-ignored --max-warnings=0"
    ],
    "../**/*": "prettier --ignore-unknown --write --ignore-path ../.gitignore --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "entities": "8.1.0",
    "parse5": "8.0.1",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/vscode": "1.120.0",
    "@types/ws": "8.18.1",
    "@vscode/debugprotocol": "1.68.0",
    "@vscode/vsce": "4.0.0",
    "c8": "12.0.0",
    "devtools-protocol": "0.0.1698617",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-ts-prefixer": "5.1.0",
    "fallow": "3.34.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "xml2js": "0.6.2",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/laststance/codebook.git",
    "directory": "extension"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
