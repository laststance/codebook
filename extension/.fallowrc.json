{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/extension.ts",
    "src/cursorMcpBridgeEntry.ts",
    "src/nativeRepositoryBootstrap.ts",
    "src/nativeNodeTestBootstrap.ts",
    "src/agentConsole.ts",
    "src/tests/**/*.test.ts",
    "scripts/**/*.mjs"
  ],
  "ignorePatterns": ["dist/**", "artifacts/**", "examples/**"],
  "ignoreFindings": ["src/tests/**", "scripts/**"],
  "health": {
    "ignore": ["src/tests/**", "scripts/**"]
  },
  "duplicates": {
    "ignore": ["src/tests/**", "scripts/**"]
  }
}
