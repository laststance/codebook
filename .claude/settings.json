{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.codex/restore-product-context.mjs\"",
            "timeout": 5,
            "statusMessage": "Restoring Codebook product context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/extension/scripts/refuse-closing-keywords.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking pull request text for closing keywords"
          }
        ]
      }
    ]
  }
}
